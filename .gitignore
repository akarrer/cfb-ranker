# Downloaded third-party data (EA player ratings, CFBD responses) — fetched at runtime, not redistributed
data/raw/

# ESPN scoreboard / betting-line / odds dumps from ad-hoc analysis
/*.json

# Intermediate analysis artifacts (regenerated by the CLI)
data/output/*.json

# Python
__pycache__/
*.pyc

# Secrets — the CFBD key is read from the CFBD_API_KEY environment variable, never a file
.env
